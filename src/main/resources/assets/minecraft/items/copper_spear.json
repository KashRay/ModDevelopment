{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": ["gui", "ground", "fixed"],
        "model": {
          "type": "minecraft:range_dispatch",
          "property": "minecraft:damage",
          "fallback": {
            "type": "minecraft:model",
            "model": "minecraft:item/copper_spear"
          },
          "entries": [
            { "threshold": 0.25, "model": { "type": "minecraft:model", "model": "djsfixedprogression:item/exposed_copper_spear" } },
            { "threshold": 0.50, "model": { "type": "minecraft:model", "model": "djsfixedprogression:item/weathered_copper_spear" } },
            { "threshold": 0.75, "model": { "type": "minecraft:model", "model": "djsfixedprogression:item/oxidized_copper_spear" } }
          ]
        }
      }
    ],
    "fallback": {
      "type": "minecraft:range_dispatch",
      "property": "minecraft:damage",
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/copper_spear_in_hand"
      },
      "entries": [
        { "threshold": 0.25, "model": { "type": "minecraft:model", "model": "djsfixedprogression:item/exposed_copper_spear_in_hand" } },
        { "threshold": 0.50, "model": { "type": "minecraft:model", "model": "djsfixedprogression:item/weathered_copper_spear_in_hand" } },
        { "threshold": 0.75, "model": { "type": "minecraft:model", "model": "djsfixedprogression:item/oxidized_copper_spear_in_hand" } }
      ]
    }
  }
}